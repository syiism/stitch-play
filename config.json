{
  "_comment": "数据源与代理配置模板。复制为 config.json 后按需修改；配置缺失时 server.py 与前端均回退到本示例。",
  "proxies": [
    { "prefix": "mf", "upstream": "https://muyangmodelscope-mufan.ms.show" }
  ],
  "sources": [
    { 
      "id": "mufan-short", 
      "label": "沐凡 · 短剧", 
      "category": "short", 
      "mode": "declarative",
      "proxy": "mf",
      "config": {
        "endpoints": {
          "discover": "/api/bookmall/cell/change",
          "search": "/api/search",
          "directory": "/api/directory",
          "video": "/api/video"
        },
        "params": {
          "discover": { "algo_type": 101 },
          "search": {},
          "directory": {},
          "video": { "type": "json", "proxy": 1 }
        },
        "mapping": {
          "videoId": "series_id",
          "title": "title",
          "poster": "cover",
          "collectionId": "series_id",
          "category": "_category_short"
        },
        "transform": {
          "videoId": ["string", { "prefix": "mf-drama-" }],
          "collectionId": ["string", { "prefix": "mf-col-" }]
        },
        "listPath": "book_info",
        "collectionItemsPath": "item_data_list",
        "_category_short": "短剧"
      }
    },
    { 
      "id": "mufan-manju", 
      "label": "沐凡 · 漫剧", 
      "category": "manju", 
      "mode": "declarative",
      "proxy": "mf",
      "config": {
        "endpoints": {
          "discover": "/api/bookmall/cell/change",
          "search": "/api/search",
          "directory": "/api/directory",
          "video": "/api/video"
        },
        "params": {
          "discover": { "genre_tab": 5, "algo_type": 101 },
          "search": { "tab_type": 19 },
          "directory": {},
          "video": { "type": "json", "proxy": 1 }
        },
        "mapping": {
          "videoId": "series_id",
          "title": "title",
          "poster": "cover",
          "collectionId": "series_id",
          "category": "_category_manju"
        },
        "transform": {
          "videoId": ["string", { "prefix": "mf-drama-" }],
          "collectionId": ["string", { "prefix": "mf-col-" }]
        },
        "listPath": "book_info",
        "collectionItemsPath": "item_data_list",
        "_category_manju": "漫剧"
      }
    }
  ],
  "mufan_api": {
    "discover": "/api/bookmall/cell/change",
    "search": "/api/search",
    "directory": "/api/directory",
    "video": "/api/video"
  },
  "tabs": {
    "short": { "genre_tab": 4, "search_tab": 11 },
    "manju": { "genre_tab": 5, "search_tab": 19 }
  },
  "request": { "timeout_ms": 45000 }
}